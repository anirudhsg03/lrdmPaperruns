# AuGaAsSiO2H_20 | geometry source: lrdm_paper_runs_sambit/fromStampede/dftfeRuns/AuGaAsSiO2H_repeat_20
# XC = MGGA-SCAN, mixing = ANDERSON_WITH_LDOS, SG15 ONCV pseudopotentials
set SOLVER MODE = GS
set VERBOSITY   = 4
set USE GPU     = true

subsection Geometry
  set NATOMS                  = 258
  set NATOM TYPES             = 6
  set ATOMIC COORDINATES FILE = coordinates.inp
  set DOMAIN VECTORS FILE     = domainVectors.inp
end

subsection Boundary conditions
  set PERIODIC1                     = true
  set PERIODIC2                     = true
  set PERIODIC3                     = true
  set MULTIPOLE BOUNDARY CONDITIONS = false
end

subsection Brillouin zone k point sampling options
  set USE TIME REVERSAL SYMMETRY = true
  set USE GROUP SYMMETRY         = false
  subsection Monkhorst-Pack (MP) grid generation
    set SAMPLING POINTS 1 = 4
    set SAMPLING POINTS 2 = 6
    set SAMPLING POINTS 3 = 1
    set SAMPLING SHIFT 1  = 1
    set SAMPLING SHIFT 2  = 1
    set SAMPLING SHIFT 3  = 0
  end
end

subsection Finite element mesh parameters
  set POLYNOMIAL ORDER                 = 7
  set DENSITY QUADRATURE RULE          = 18
  set LOCAL POTENTIAL QUADRATURE ORDER = 20
  set LOCAL POTENTIAL QUADRATURE COPY  = 1
  set NON LOCAL PSP QUADRATURE ORDER   = 20
  set NON LOCAL PSP QUADRATURE COPY    = 1
  # pre-f100d7ca5 hard-coded smeared-charge rule (order 10, 2 copies for MESH SIZE AROUND ATOM <= 2.2)
  set NUCLEAR CHARGE QUADRATURE ORDER  = 10
  set NUCLEAR CHARGE QUADRATURE COPY   = 2
  subsection Auto mesh generation parameters
    set MESH SIZE AROUND ATOM     = 1.2
    set ATOM BALL RADIUS          = 4.0
  end
end

subsection DFT functional parameters
  set EXCHANGE CORRELATION TYPE       = MGGA-SCAN
  set PSEUDOPOTENTIAL CALCULATION     = true
  set PSEUDOPOTENTIAL FILE NAMES LIST = pseudo.inp
  set SPIN POLARIZATION               = 0
end

subsection Poisson problem parameters
  set MAXIMUM ITERATIONS = 20000
  set TOLERANCE          = 1e-10
end

subsection SCF parameters
  set TEMPERATURE                     = 500
  set MIXING METHOD                   = ANDERSON_WITH_LDOS
  set MIXING PARAMETER                = 0.5
  set LDOS TEMPERATURE                = 10000
  set ADAPT ANDERSON MIXING PARAMETER = false
  set TOLERANCE                       = 1e-5
  set MAXIMUM ITERATIONS              = 250
  subsection Eigen-solver parameters
    set USE SINGLE PREC CHEBY            = true
    set COMMUN PREC CHEBY                = BF16
    set TENSOR OP TYPE SINGLE PREC CHEBY = TF32
  end
end
